{
  "type": "object",
  "required": ["base", "title", "defaultTimeZone", "themeColor"],
  "properties": {
    "features": {
      "type": "object",
      "default": {
        "search": true,
        "favicon": true,
        "footer": true,
        "pickers": true
      },
      "properties": {
        "search": { "type": "boolean", "default": true },
        "favicon": { "type": "boolean", "default": true },
        "footer": { "type": "boolean", "default": true },
        "pickers": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "base": { "type": "string", "pattern": "^https?:\\/\\/[-.:a-zA-Z0-9]+$" },
    "basePath": {
      "type": "string",
      "default": "/",
      "pattern": "^\\/[-a-zA-Z0-9]*?$"
    },
    "internalDomains": {
      "type": "array",
      "default": [],
      "items": { "type": "string", "pattern": "^[-.:a-zA-Z0-9]+$" }
    },
    "title": { "type": "string" },
    "banner": { "type": "string" },
    "symbol": { "type": "string", "pattern": "^[A-Z0-9\\- ]{1,5}$" },
    "titlePostfix": { "type": "string" },
    "themeColor": { "type": "string" },
    "tintHue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 360,
      "default": 20
    },
    "tintAmount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 100
    },
    "faviconColor": { "type": "string" },
    "faviconSymbol": { "type": "string", "pattern": "^[A-Z0-9\\- ]{1,5}$" },
    "faviconFontWeight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 700
    },
    "defaultTimeZone": { "type": "string" },
    "defaultFont": {
      "type": "string",
      "enum": ["sans", "serif"],
      "default": "sans"
    },
    "defaultContrast": {
      "type": "string",
      "enum": ["standard", "high"],
      "default": "standard"
    },
    "fontOverrides": {
      "type": "object",
      "properties": {
        "serif": { "$ref": "#/$defs/serifFontOverride" },
        "serifMono": { "$ref": "#/$defs/serifMonoFontOverride" }
      },
      "additionalProperties": false
    },
    "vars": { "type": "object" },
    "extensionToShikiLanguage": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "shikiLanguages": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "serifFontOverride": {
      "type": "object",
      "required": ["regular"],
      "properties": {
        "regular": { "$ref": "#/$defs/publicWoff2Path" },
        "italic": { "$ref": "#/$defs/publicWoff2Path" },
        "bold": { "$ref": "#/$defs/publicWoff2Path" },
        "boldItalic": { "$ref": "#/$defs/publicWoff2Path" },
        "features": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9]{4}$" },
          "uniqueItems": true
        },
        "tuning": {
          "type": "object",
          "properties": {
            "scale": { "$ref": "#/$defs/fontScale" },
            "lineHeight": { "$ref": "#/$defs/fontLineHeight" },
            "headingScale": { "$ref": "#/$defs/fontScale" },
            "headingWeight": { "type": "integer", "enum": [400, 700] },
            "fontSizeAdjust": { "$ref": "#/$defs/fontSizeAdjust" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "serifMonoFontOverride": {
      "type": "object",
      "required": ["regular"],
      "properties": {
        "regular": { "$ref": "#/$defs/publicWoff2Path" },
        "italic": { "$ref": "#/$defs/publicWoff2Path" },
        "bold": { "$ref": "#/$defs/publicWoff2Path" },
        "boldItalic": { "$ref": "#/$defs/publicWoff2Path" },
        "features": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9]{4}$" },
          "uniqueItems": true
        },
        "tuning": {
          "type": "object",
          "properties": {
            "scale": { "$ref": "#/$defs/fontScale" },
            "lineHeight": { "$ref": "#/$defs/fontLineHeight" },
            "fontSizeAdjust": { "$ref": "#/$defs/fontSizeAdjust" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fontScale": { "type": "number", "minimum": 0.75, "maximum": 1.5 },
    "fontLineHeight": { "type": "number", "minimum": 1, "maximum": 2.5 },
    "fontSizeAdjust": { "type": "number", "exclusiveMinimum": 0 },
    "publicWoff2Path": {
      "type": "string",
      "minLength": 6,
      "pattern": "\\.woff2$"
    }
  },
  "additionalProperties": false
}

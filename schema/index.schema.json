{
  "$ref": "#/$defs/branch",
  "$defs": {
    "sourcePath": { "type": "string", "minLength": 1 },
    "node": {
      "oneOf": [{ "$ref": "#/$defs/sourcePath" }, { "$ref": "#/$defs/branch" }]
    },
    "branch": {
      "type": "object",
      "required": ["page", "children"],
      "properties": {
        "page": { "$ref": "#/$defs/sourcePath" },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "additionalProperties": false
    }
  }
}
